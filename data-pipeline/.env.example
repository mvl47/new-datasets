# Copy to .env and fill in your credentials before running fetchers that need them.

# Destatis GENESIS-Online — register at https://www.regionalstatistik.de/genesis/online
# and create an API token in your account.
DESTATIS_API_TOKEN=

# Copernicus Climate Data Store — register at https://cds.climate.copernicus.eu
# and create an API key at https://cds.climate.copernicus.eu/profile
CDS_API_KEY=
CDS_API_URL=https://cds.climate.copernicus.eu/api

# Optional override: where pipeline artifacts get written.
# Default: ../apps/web/public/data relative to this directory.
# FFE_OUTPUT_DIR=
